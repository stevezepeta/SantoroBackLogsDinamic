# ====================================================================
# Variables de Entorno - Ambiente Quintana Roo (Puerto 8057)
# ====================================================================
# Este archivo contiene todas las variables de entorno necesarias
# para configurar el ambiente de Quintana Roo de forma independiente
#
# NOTA: Este es un archivo de EJEMPLO.
# En producción, estas variables deben configurarse de forma segura
# ====================================================================

# ===== CONFIGURACIÓN DEL SERVIDOR =====
SERVER_PORT=8057

# ===== BASE DE DATOS MONGODB =====
# Cambiar logs_quintanaroo por el nombre de la base de datos real
MONGODB_URI=mongodb://localhost:27017/logs_quintanaroo
MULTITENANT_BASE_DATABASE=logs_quintanaroo

# ===== WEBSOCKET =====
# Valores posibles:
#   * = Permitir todos los orígenes (solo para desarrollo/testing)
#   URL específica = https://dashboard-quintanaroo.grupo-santoro.com.mx
#   Múltiples URLs = https://dashboard-quintanaroo.grupo-santoro.com.mx,https://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=*

# ===== CONFIGURACIÓN DE CORREO =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=soporte.tecnico@grupo-santoro.com.mx
MAIL_PASSWORD=wnnkjroexgypcpss
MAIL_FROM=soporte.tecnico@grupo-santoro.com.mx
MAIL_FROM_NAME=Backlogs Santoro - Quintana Roo

# ===== PERFIL DE SPRING BOOT =====
# Valores posibles: dev, prod, mail
SPRING_PROFILES_ACTIVE=prod

# ===== OPENAI (Opcional - para funcionalidades de IA) =====
# OPENAI_API_KEY=sk-...
EVA_OPENAI_API_KEY=

